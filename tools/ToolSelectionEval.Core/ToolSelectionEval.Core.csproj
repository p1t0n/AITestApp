<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CvManager.ToolSelectionEval</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <!-- For the HTTP status and service message behind a failed call: the OpenAI-compat client
         reports every fault as "Service request failed.", which cannot be diagnosed (P1T-137). -->
    <PackageReference Include="System.ClientModel" Version="1.10.0" />
  </ItemGroup>

</Project>
