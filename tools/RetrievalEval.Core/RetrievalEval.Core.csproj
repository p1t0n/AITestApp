<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExpertToJob.RetrievalEval</RootNamespace>
    <AssemblyName>ExpertToJob.RetrievalEval.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Frozen eval fixtures: copied to output (transitively for consumers) so both the tests and
         the CLI load the exact same committed files. -->
    <None Include="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The query capture's soft-error ladder (EXP-87). Nothing else here reaches Polly, so unlike
         the agents this project pulls it in directly rather than transitively. -->
    <PackageReference Include="Polly.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Infrastructure\ExpertToJob.Infrastructure.csproj" />
  </ItemGroup>

</Project>
