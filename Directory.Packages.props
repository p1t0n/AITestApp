<!--
  Central Package Management: the single version list for ExpertToJob.slnx (P1T-222).

  Every `PackageReference` in the repo names a package; none of them names a version. The version
  lives here, once, and NuGet resolves the pair by package id. A project that wants a package still
  declares it — CPM centralises *versions*, not *dependencies*, so the dependency graph a csproj
  describes is unchanged.

  This file was a pure relocation. The migration that created it changed no version: all 89
  `PackageReference` elements across 24 projects already agreed, at 43 distinct package ids with
  zero id pinned at two versions. That is recorded in P1T-222 because it is the interesting part —
  the agreement was maintained by hand, one ticket at a time (P1T-214 consolidated OpenTelemetry,
  P1T-223 set the Microsoft.Extensions.AI floor), and this file is what makes the next one
  unnecessary rather than merely overdue.

  Where a comment goes. A comment explaining *why this version* moved here with the version — those
  are below. A comment explaining *why this project takes this dependency at all* stayed on the
  `PackageReference` in its csproj, because that is what it is about.

  No `<packageSources>` is declared here and no `NuGet.config` exists in this repo. That is
  load-bearing: the Aspire SDK resolves from nuget.org before any `PackageReference` is considered,
  so a restricted feed breaks the AppHost build in a way that looks nothing like a package problem
  (manuals/adr-aspire-apphost.md). This file configures versions and nothing else.
-->
<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!--
      Off, deliberately, and written out rather than left to the default so that its absence reads
      as a decision. Transitive pinning promotes every indirectly-referenced package to a version
      this repo owns and must maintain — versions nobody here chose, on a list nobody here reads.
      The one place transitive versions ever needed a hand was EF Core Relational, where EF 10 and
      Npgsql 10 disagreed and a direct reference from Infrastructure settled it. On EF 11 + Npgsql
      11 they agree, so that reference is gone (EXP-73) and nothing here pins a transitive version.
    -->
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Orchestration -->
  <ItemGroup>
    <!--
      Must stay in lockstep with the AppHost SDK attribute, which CPM cannot reach:
      `Sdk="Aspire.AppHost.Sdk/13.6.0"` on the first line of api/AppHost/ExpertToJob.AppHost.csproj.
      Changing one without the other throws at AppHost *startup*, not at restore —
      MissingMethodException on ProjectResource.get_DefaultHttpsEndpoint, or TypeLoadException on
      ExecutableLaunchConfiguration (microsoft/aspire#13636). Edit both, always;
      AspireVersionLockstepTests fails the suite when they disagree.
      No prerelease Aspire package enters this solution (manuals/adr-aspire-apphost.md).
    -->
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.6.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.0" />
  </ItemGroup>

  <!-- Web hosts and API surface -->
  <ItemGroup>
    <PackageVersion Include="Fido2.AspNet" Version="4.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0-rc.1.26425.128" />
    <!--
      The UI package alone (EXP-74). The CVE-2026-49451 note that stood here was about
      Swashbuckle.AspNetCore.Swagger's transitive Microsoft.OpenApi pin, and the generator it
      belonged to is gone — SwaggerUI is static assets and a middleware, and reads no document.
    -->
    <PackageVersion Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <!-- Application layer -->
  <ItemGroup>
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-rc.1.26425.128" />
  </ItemGroup>

  <!-- Persistence -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-rc.1.1" />
    <PackageVersion Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>

  <!-- Agents, AI and MCP -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.22.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <!--
      Lifted past the MCP SDK's own 10.7.0 (P1T-223). Every MCP tool's input schema is generated by
      Microsoft.Extensions.AI.Abstractions, and 10.7.0 keyed a method's parameter-binding options on
      ParameterInfo object IDENTITY while the schema generator re-fetched its own ParameterInfo
      instances from MethodInfo.GetParameters(). Two threads racing that method's non-atomic lazy
      parameter cache — which is exactly what several test hosts starting at once does — made the
      identity lookup miss, silently dropping ExcludeFromSchema and PUBLISHING the tool's injected
      service parameter to the model. dotnet/extensions#7677 re-keyed it by position; 10.9.0 is the
      first release carrying that fix. Do not float this back below 10.9.0.
    -->
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <!--
      The chat seam constructs an OpenAIClient by hand (EXP-17), so the package it comes from is
      referenced directly rather than ridden in on Microsoft.Extensions.AI.OpenAI's coat-tails.
      M.E.AI.OpenAI 10.9.0 pinned this to [2.12.0, 2.13.0); 10.10.0 relaxed that to a plain floor,
      OpenAI >= 2.13.0, which Microsoft.Agents.AI 1.22.0 shares. A version below 2.13.0 is therefore
      a restore error, and one above it is merely a bump. OpenAI 2.14.0 in turn floors
      System.ClientModel at 1.15.0.
    -->
    <PackageVersion Include="OpenAI" Version="2.14.0" />
    <PackageVersion Include="System.ClientModel" Version="1.16.0" />
  </ItemGroup>

  <!-- Telemetry and resilience spine (api/ServiceDefaults, P1T-214) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
    <!--
      The retry ladders the agents and the retrieval eval ride out a provider 429 with (EXP-87).
      Http.Resilience already carries exactly this version in, so this entry pins nothing new — it
      lets the two projects that build a pipeline by hand say so, instead of reaching through a
      transitive edge they do not own.
    -->
    <PackageVersion Include="Polly.Core" Version="8.4.2" />
  </ItemGroup>

  <!-- Documents -->
  <ItemGroup>
    <PackageVersion Include="QuestPDF" Version="2026.9.0" />
  </ItemGroup>

  <!-- Test-only -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <PackageVersion Include="Testcontainers.Keycloak" Version="4.15.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

</Project>
