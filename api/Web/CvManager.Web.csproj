    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\CvManager.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\CvManager.Infrastructure.csproj" />
  </ItemGroup>

</Project>
