<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ExpertToJob.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Infrastructure, not Application: this process applies a schema and seeds a catalog, and knows
      nothing about services, DTOs or validation. ServiceDefaults gives it the same telemetry and
      health spine the three hosts take (P1T-214) — a migration that hangs should be visible in the
      dashboard like anything else.
    -->
    <ProjectReference Include="..\Infrastructure\ExpertToJob.Infrastructure.csproj" />
    <ProjectReference Include="..\ServiceDefaults\ExpertToJob.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
