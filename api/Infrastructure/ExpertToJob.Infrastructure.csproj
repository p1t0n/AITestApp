<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Application\ExpertToJob.Application.csproj" />
    <ProjectReference Include="..\Domain\ExpertToJob.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Referenced only to unify the transitive EF Core version; see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Pgvector" />
    <!-- Server-side CV render (P1T-139). Community licence: free at this project's scale, and it
         needs no browser process, so the render stays usable from a worker or an agent path. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- The committed demo roster ships inside the assembly so DemoRosterSeeder works from any
         output directory (Web startup, the SeedDemoRoster tool, tests). -->
    <EmbeddedResource Include="Persistence\SeedData\demo-roster.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
