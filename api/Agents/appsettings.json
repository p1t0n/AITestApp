{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
    "Model": "gemini-flash-lite-latest",
    "ApiKey": ""
  },
  "McpAuth": {
    "roster-qa": {
      "Authority": "http://localhost:8080/realms/cv-manager",
      "ClientId": "agent-roster-qa",
      "ClientSecret": "agent-roster-qa-secret",
      "Scope": "mcp:read"
    },
    "cv-tailoring": {
      "Authority": "http://localhost:8080/realms/cv-manager",
      "ClientId": "agent-cv-tailoring",
      "ClientSecret": "agent-cv-tailoring-secret",
      "Scope": "mcp:read"
    },
    "match": {
      "Authority": "http://localhost:8080/realms/cv-manager",
      "ClientId": "agent-match",
      "ClientSecret": "agent-match-secret",
      "Scope": "mcp:read"
    },
    "shortlist": {
      "Authority": "http://localhost:8080/realms/cv-manager",
      "ClientId": "agent-shortlist",
      "ClientSecret": "agent-shortlist-secret",
      "Scope": "mcp:read"
    }
  },
  "McpServer": {
    "BaseUrl": "http://localhost:5100"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=cvmanager;Username=postgres;Password=postgres"
  },
  "Staffing": {
    "MaxConcurrentMatches": 2
  },
  "Usage": {
    "DefaultDailyTokens": 50000,
    "DefaultWeeklyTokens": 150000,
    "DefaultMonthlyTokens": 500000
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "dev-only-insecure-signing-key-change-me-at-least-32-bytes",
      "Issuer": "cvmanager",
      "Audience": "cvmanager-app"
    }
  }
}
