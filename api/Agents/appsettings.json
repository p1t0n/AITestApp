{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gemini": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai",
    "Model": "gemini-3.5-flash-lite",
    "ApiKey": ""
  },
  "McpAuth": {
    "roster-qa": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-roster-qa",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "roster_semantic_search", "skill_list", "employee_list", "cv_get" ]
    },
    "cv-tailoring": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-cv-tailoring",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "cv_get", "style_exemplar_search" ]
    },
    "match": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-match",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "cv_get" ]
    },
    "shortlist": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-shortlist",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "roster_shortlist_search" ]
    },
    "interview-kit": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-interview-kit",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "cv_get" ]
    },
    "bench-report": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-bench-report",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "employee_list" ]
    },
    "resume-ingestion": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-resume-ingestion",
      "ClientSecret": "",
      "Scope": "mcp:read mcp:write",
      "Tools": [ "skill_list", "employee_create_draft", "language_add", "employee_skill_add", "qualification_add", "experience_add" ]
    },
    "roster-scan": {
      "Authority": "http://localhost:8080/realms/expert-to-job",
      "ClientId": "agent-roster-scan",
      "ClientSecret": "",
      "Scope": "mcp:read",
      "Tools": [ "roster_digest_list" ]
    }
  },
  "McpServer": {
    "BaseUrl": "http://localhost:5100"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=experttojob;Username=postgres;Password=postgres"
  },
  "Staffing": {
    "MaxConcurrentMatches": 2
  },
  "AgentBudgets": {
    "Default": { "MaxInputTokens": 20000, "MaxIterations": 6 },
    "Agents": {
      "roster-qa": { "MaxInputTokens": 15000, "MaxIterations": 6 },
      "resume-ingestion": { "MaxInputTokens": 40000, "MaxIterations": 24 }
    }
  },
  "Usage": {
    "DefaultDailyTokens": 50000,
    "DefaultWeeklyTokens": 150000,
    "DefaultMonthlyTokens": 500000
  },
  "Auth": {
    "Jwt": {
      "SigningKey": "",
      "Issuer": "experttojob",
      "Audience": "experttojob-app"
    }
  }
}
