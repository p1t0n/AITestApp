  "SemanticSearch": {
    "MinSimilarity": 0.30,
    "DefaultTopK": 5,
    "MaxTopK": 20,
    "MaxSnippetsPerEmployee": 3,
    "SnippetMaxChars": 500
  },
  "Mcp": {
    "ApiKey": ""
  }
}
