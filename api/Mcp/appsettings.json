{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=cvmanager;Username=postgres;Password=postgres"
  },
  "GitHubModels": {
    "Endpoint": "https://models.github.ai/inference",
    "EmbeddingModel": "text-embedding-3-small",
