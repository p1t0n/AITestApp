      ]
    },
    {
      "clientId": "agent-interview-kit",
      "name": "Interview Kit agent (confidential, mcp:read only)",
      "enabled": true,
      "publicClient": false,
      "secret": "agent-interview-kit-secret",
      "standardFlowEnabled": false,
