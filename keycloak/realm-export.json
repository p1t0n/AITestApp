      "enabled": true,
      "publicClient": false,
      "secret": "agent-cv-tailoring-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "mcp-audience",
