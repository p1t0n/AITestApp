      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:tool:employee_list"
      ]
    },
    {
      "clientId": "agent-resume-ingestion",
      "name": "Resume Ingestion agent (confidential, mcp:read + mcp:write — stages drafts only)",
      "enabled": true,
      "publicClient": false,
      "secret": "agent-resume-ingestion-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:write",
        "mcp:tool:employee_create_draft",
        "mcp:tool:employee_skill_add",
        "mcp:tool:experience_add",
