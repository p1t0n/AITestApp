{
  "realm": "cv-manager",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "clientScopes": [
    {
      "name": "mcp-audience",
      "description": "Adds the MCP server as the token audience (RFC 8707).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "mcp-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "https://localhost/mcp",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "name": "mcp:read",
      "description": "Read-only MCP tools.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "mcp:write",
      "description": "Create/update MCP tools.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "mcp:admin",
      "description": "Destructive (delete) MCP tools.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true"
      }
    },
    {
      "name": "mcp:tool:cv_get",
      "description": "Grants the cv_get MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:employee_create_draft",
      "description": "Grants the employee_create_draft MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:employee_list",
      "description": "Grants the employee_list MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:employee_skill_add",
      "description": "Grants the employee_skill_add MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:experience_add",
      "description": "Grants the experience_add MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:language_add",
      "description": "Grants the language_add MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:qualification_add",
      "description": "Grants the qualification_add MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:roster_digest_list",
      "description": "Grants the roster_digest_list MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:roster_semantic_search",
      "description": "Grants the roster_semantic_search MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:roster_shortlist_search",
      "description": "Grants the roster_shortlist_search MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:skill_list",
      "description": "Grants the skill_list MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "mcp:tool:style_exemplar_search",
      "description": "Grants the style_exemplar_search MCP tool.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    }
  ],
  "clients": [
    {
      "clientId": "cv-manager-mcp",
      "name": "CV Manager MCP (public PKCE client)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:*",
        "http://127.0.0.1:*"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "require.pushed.authorization.requests": "false"
      },
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:write"
      ],
      "optionalClientScopes": [
        "mcp:admin"
      ]
    },
    {
      "clientId": "cv-manager-e2e",
      "name": "CV Manager e2e (confidential, test only)",
      "enabled": true,
      "publicClient": false,
      "secret": "e2e-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:write",
        "mcp:admin"
      ]
    },
    {
      "clientId": "agent-roster-qa",
      "name": "Roster Q&A agent (confidential, mcp:read only)",
      "enabled": true,
      "publicClient": false,
      "secret": "agent-roster-qa-secret",
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:tool:cv_get",
        "mcp:tool:employee_list",
        "mcp:tool:roster_semantic_search",
        "mcp:tool:skill_list"
      ]
    },
    {
      "clientId": "agent-cv-tailoring",
