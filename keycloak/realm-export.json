      ]
    },
    {
      "clientId": "agent-bench-report",
      "name": "Bench report agent (confidential, mcp:read only)",
      "enabled": true,
      "publicClient": false,
      "secret": "agent-bench-report-secret",
      "standardFlowEnabled": false,
