      "directAccessGrantsEnabled": false,
      "defaultClientScopes": [
        "mcp-audience",
        "mcp:read",
        "mcp:tool:cv_get"
      ]
    },
    {
      "clientId": "agent-shortlist",
      "name": "Shortlist agent (confidential, mcp:read only)",
      "enabled": true,
