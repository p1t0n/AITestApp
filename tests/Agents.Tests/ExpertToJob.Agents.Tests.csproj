<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Web host's shipped session identity, read as data by the lockstep test. Agents does
         not reference the Web project, and that separation is precisely what can drift. -->
    <None Include="..\..\api\Web\appsettings.json" Link="web-appsettings.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\api\Agents\ExpertToJob.Agents.csproj" />
    <!-- Eval-only: the ingestion eval's fake MCP tools validate with the REAL Application
         validators so the self-correction loop sees production error shapes. -->
    <ProjectReference Include="..\..\api\Application\ExpertToJob.Application.csproj" />
    <ProjectReference Include="..\..\tools\ExtractionEval.Core\ExtractionEval.Core.csproj" />
    <ProjectReference Include="..\..\tools\CostFloors.Core\CostFloors.Core.csproj" />
  </ItemGroup>

</Project>
